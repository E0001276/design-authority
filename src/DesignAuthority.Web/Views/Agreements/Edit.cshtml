@model DesignAuthority.Web.ViewModels.Agreements.AgreementViewModel
@{
    ViewData["Title"] = "Editar Acuerdo";
}
<h1>Editar Acuerdo @ViewData["AgreementId"]</h1>
<form method="post" asp-action="Edit" asp-route-id="@ViewData["AgreementId"]"><partial name="_Form" model="Model" /><button class="btn btn-primary mt-3" type="submit">Guardar cambios</button><a class="btn btn-link" asp-action="Index">Cancelar</a></form>
