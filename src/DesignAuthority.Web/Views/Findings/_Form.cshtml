@model DesignAuthority.Web.ViewModels.Findings.FindingViewModel
@{
    var options = Model.Options!;
}
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-4"><label asp-for="RegistrationDate" class="form-label"></label><input asp-for="RegistrationDate" class="form-control" /><span asp-validation-for="RegistrationDate" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="TramiteId" class="form-label">Trámite</label><select asp-for="TramiteId" class="form-select"><option value="0">Seleccione un Trámite</option>@foreach (var item in options.Tramites){<option value="@item.Id" selected="@(Model.TramiteId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="TramiteId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="SubstageId" class="form-label">Subetapa</label><select asp-for="SubstageId" class="form-select" data-substage-select><option value="0">Seleccione una Subetapa</option>@foreach (var item in options.Substages){<option value="@item.Id" data-tramite-id="@item.ParentId" selected="@(Model.SubstageId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="SubstageId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="TechnologyId" class="form-label">Tecnología</label><select asp-for="TechnologyId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.Technologies){<option value="@item.Id" selected="@(Model.TechnologyId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="TechnologyId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CategoryId" class="form-label">Categoría</label><select asp-for="CategoryId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.Categories){<option value="@item.Id" selected="@(Model.CategoryId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="StatusId" class="form-label">Estatus</label><select asp-for="StatusId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.Statuses){<option value="@item.Id" selected="@(Model.StatusId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="StatusId" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Descripción</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="ResponsiblePersonId" class="form-label">Persona responsable</label><select asp-for="ResponsiblePersonId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.People){<option value="@item.Id" selected="@(Model.ResponsiblePersonId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="ResponsiblePersonId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CriticalityId" class="form-label">Criticidad</label><select asp-for="CriticalityId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.Criticalities){<option value="@item.Id" selected="@(Model.CriticalityId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="CriticalityId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PriorityId" class="form-label">Prioridad</label><select asp-for="PriorityId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.Priorities){<option value="@item.Id" selected="@(Model.PriorityId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="PriorityId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="RegistrationPhaseId" class="form-label">Fase de registro</label><select asp-for="RegistrationPhaseId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.RegistrationPhases){<option value="@item.Id" selected="@(Model.RegistrationPhaseId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="RegistrationPhaseId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="AttentionPhaseId" class="form-label">Fase de atención</label><select asp-for="AttentionPhaseId" class="form-select"><option value="0">Seleccione</option>@foreach (var item in options.AttentionPhases){<option value="@item.Id" selected="@(Model.AttentionPhaseId == item.Id ? "selected" : null)">@item.Name</option>}</select><span asp-validation-for="AttentionPhaseId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CommitmentDate" class="form-label">Fecha compromiso</label><input asp-for="CommitmentDate" class="form-control" /><span asp-validation-for="CommitmentDate" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="SolutionDate" class="form-label">Fecha de solución (opcional)</label><input asp-for="SolutionDate" class="form-control" /><span asp-validation-for="SolutionDate" class="text-danger"></span></div>
</div>
